{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "texinfo",
      "camelcase": "Texinfo",
      "title": "GNU Texinfo",
      "scope": "source.texinfo",
      "file-types": [
        "texi",
        "txi",
        "texinfo"
      ],
      "first-line-regex": "^\\\\input texinfo",
      "injection-regex": "^texinfo$",
      "class-name": "TreeSitterTexinfo",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.5.1",
    "license": "MIT",
    "description": "Texinfo grammar for tree-sitter",
    "authors": [
      {
        "name": "Janko Lisica",
        "email": "janko.lisica@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/chislobog/tree-sitter-texinfo"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
