{
  "name": "tree-sitter-texinfo",
  "version": "0.5.0",
  "description": "Texinfo grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chislobog/tree-sitter-texinfo.git"
  },
  "license": "MIT",
  "author": {
    "name": "Janko Lisica",
    "email": "janko.lisica@gmail.com",
    "url": ""
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "engines": {
    "node": ">=18.20"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "texinfo"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.11"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "lint": "eslint grammar.js"
  }
}
