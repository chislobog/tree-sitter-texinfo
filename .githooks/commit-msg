#!/usr/bin/env bash
# Checks that the commit message follows Conventional Commits:
#   type(scope)!: summary
set -euo pipefail

subject=$(grep -v '^#' "$1" | head -n 1)

# Messages git writes itself.
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: .+"; then
  cat >&2 <<MSG
Commit message doesn't follow Conventional Commits:

  $subject

Expected "type(scope)!: summary", where type is one of
${types//|/, }; the scope and the ! (breaking change) are optional.
MSG
  exit 1
fi
