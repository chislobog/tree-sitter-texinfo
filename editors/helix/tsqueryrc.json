      "markup.heading.2": "heading text for h1 through h6",
      "markup.heading.3": "heading text for h1 through h6",
      "markup.heading.4": "heading text for h1 through h6",
      "markup.heading.5": "heading text for h1 through h6",
      "markup.heading.6": "heading text for h1 through h6",
      "markup.heading.marker": "",
      "markup.italic": "",
      "markup.link": "",
      "markup.link.label": "non-URL link references",
      "markup.link.text": "URL and image descriptions in links",
      "markup.link.url": "URLs pointed to by links",
      "markup.list": "",
      "markup.list.checked": "",
      "markup.list.numbered": "",
      "markup.list.unchecked": "",
      "markup.list.unnumbered": "",
      "markup.quote": "",
      "markup.raw": "",
      "markup.raw.block": "",
      "markup.raw.inline": "",
      "markup.strikethrough": "",
      "namespace": "",
      "operator": "`||`, `+=`, `>`",
      "punctuation": "",
